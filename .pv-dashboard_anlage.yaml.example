##############################################################################
# Vorlage fuer die eigene Anlage: Beschriftungen im Schema und Tarife
#
# Diese Datei liegt im Repo und traegt die Demo-Werte. Die eigene Fassung
# heisst .pv-dashboard_anlage.yaml, liegt daneben und kommt NICHT ins Repo
# (.gitignore schliesst sie aus, ein "git add -A" nimmt sie nicht mit).
# Einrichten, aus dem Projektordner:
#
#   cp .pv-dashboard_anlage.yaml.example .pv-dashboard_anlage.yaml
#
# und dort die eigenen Werte eintragen. pv-dashboard.yaml bindet die Datei
# ein; fehlt sie, bricht "esphome config" mit "Could not find file" ab --
# wie bei einer fehlenden secrets.yaml.
#
# Eingebunden wird sie in den substitutions von pv-dashboard.yaml per
# "<<: !include". Die Werte zaehlen damit als Substitutions der Hauptdatei
# und stechen die Standards in den Seiten-Paketen, genau wie zuvor, als sie
# direkt in pv-dashboard.yaml standen (geprueft mit 2026.9.0). Deshalb
# steht hier auch kein "substitutions:" davor -- nur Name und Wert.
#
# Eine geloeschte Zeile faellt auf den Demo-Wert des Pakets zurueck, eine
# zusaetzliche Zeile gibt es nicht: Nur die hier genannten Namen werden im
# Schema eingesetzt. Geheimnisse gehoeren nicht hierher, sondern in die
# secrets.yaml; !secret steht weiterhin nur in pv-dashboard.yaml.
#
# Die Kaesten sind knapp gerechnet. Eine laengere Beschriftung sprengt den
# Kasten oder wird von LVGL mit "..." gekuerzt (long_mode DOT). Hinter
# jeder Zeile steht deshalb "Breite des Demo-Werts von verfuegbarer
# Breite", in Pixeln und in der Schrift des jeweiligen Kastens gemessen.
# Die Kontrolle fuer die eigenen Werte ist der Vergleich mit genau diesen
# Zahlen: Bleibt die eigene Beschriftung unter der verfuegbaren Breite,
# passt sie.
#
# Der Screenshot-Lauf zeigt die eigenen Werte NICHT. Er baut ueber
# pv-dashboard-sim.yaml, und keine der beiden Dateien bindet diese Datei
# ein -- auf den Bildern stehen immer die Demo-Werte aus den Seiten-Paketen.
# Wer eine eigene Beschriftung wirklich gerendert sehen will, traegt sie zum
# Messen voruebergehend in das jeweilige Seiten-Paket ein und rendert dann:
#
#   ~/.venvs/esphome-beta/bin/esphome run pv-dashboard-shots.yaml
#   sips -s format png shots/*.bmp --out shots/
#
# Danach die Checkliste in docs/04 durchgehen.
##############################################################################


# --- Dachflaechen und Module (obere Reihe im Schema, je 88 px) ---------
# Reihenfolge von links nach rechts; Platz 3 und 4 sind die zwei
# Einzelmodule am Mini-Wechselrichter.
name_pv_1: "Dach Süd"        # 56 von 88
name_pv_2: "Dach West"       # 63 von 88
name_pv_3: "Modul 1"         # 48 von 88
name_pv_4: "Modul 2"         # 48 von 88
name_pv_5: "Dach Ost"        # 53 von 88
name_pv_6: "Nebendach"       # 67 von 88
name_pv_7: "Dach Nord"       # 62 von 88
name_pv_8: "Garagendach"     # 78 von 88

# --- Wechselrichter (zweite Reihe, je 132 px) -------------------------
# Je Geraet die zwei Flaechen darueber. Die Leistung gehoert in die
# Beschriftung, sie steht sonst nirgends auf der Seite.
name_inv_1: "Voll-WR 7 kW"       #  81 von 132, Flaechen 1 und 2
name_inv_2: "Mini-WR 0,8 kW"     #  94 von 132, Module 3 und 4
name_inv_3: "Hybrid 10 kW · A"   #  98 von 132, Flaechen 5 und 6
name_inv_4: "Hybrid 10 kW · B"   #  98 von 132, Flaechen 7 und 8

# --- Rahmen um die Volleinspeisung ------------------------------------
# Sitzt auf der unteren Rahmenlinie und stanzt sie frei. Zweizeilig: Das
# "\n" im Wert ist der Zeilenumbruch, jede Zeile hat 64 px.
name_feedin: "VOLLEIN-\nSPEISUNG"   # 58 / 64 von je 64

# --- Speicher (je 108 px im Schema, 300 px auf der Speicherseite) -----
# Dieselben drei Namen tragen auch die Ringe und die Tabellenkoepfe auf
# der Speicherseite; dort stehen sie in Grossbuchstaben.
name_bat_1: "Speicher 1"     # 63 von 108
name_bat_2: "Speicher 2"     # 63 von 108
name_bat_3: "Speicher 3"     # 63 von 108
# Zweitzeile unter dem Mittelwert auf der Speicherseite (326 px)
name_bat_summary: "Mittel der drei Speicher"   # 139 von 326

# --- Hausnetz und Verbraucherschiene ----------------------------------
name_house: "Hausnetz"       #  64 von 172
name_heatpump: "Wärmepumpe"  #  83 von 94
name_misc: "Sonstige"        #  50 von 94, Sammelposten fuer alles uebrige
name_wb_1: "Wallbox 1"       #  60 von 94
name_wb_2: "Wallbox 2"       #  60 von 94
# name_heatpump steht auch als Titel der Seite Waermepumpe und in der
# Tabelle der Seite Haus (168 px), name_wb_1 und name_wb_2 auf den
# Karten der Seite Wallboxen (f_bar, 100 von 266) und ebenfalls in der
# Tabelle der Seite Haus, dort wie name_bat_1..3 (168 px).

# --- Verbraucher auf der Seite Haus -----------------------------------
# Spalte Verbraucher der Tabelle, normal geschrieben (f_text_s, 168 px).
# Dort steht auch name_heatpump (96 von 168).
name_oven: "Backofen"            #  64 von 168
name_washer: "Waschmaschine"     # 111 von 168
name_dishwasher: "Spülmaschine"  #  97 von 168
name_dryer: "Trockner"           #  62 von 168
name_baseload: "Grundlast"       #  67 von 168

# --- Zaehler (untere Reihe) -------------------------------------------
name_meter_pv: "PV-Zähler"      #  59 von 122, Zaehler des Volleinspeise-Kreises
name_grid: "Hausanschluss"      #  86 von 158, Netzpunkt in der Mitte
name_meter_house: "Hauszähler"  #  65 von 122, Einspeisung und Bezug des Hauses

# --- Zweitzeile der Kachel Eigenverbrauch (92 px) ---------------------
# Die Quote laesst die Volleinspeisung aussen vor (docs/01). Bewusst ein
# eigener Text und kein Verweis auf name_inv_1: Der Name traegt dort die
# Leistung mit, "ohne Voll-WR 7 kW" waere 112 px breit und wuerde in der
# nur 92 px schmalen Kachel umbrechen. Wer name_inv_1 aendert, zieht
# hier von Hand nach.
name_selfuse_note: "ohne Voll-WR"   # 79 von 92

# --- Tarife fuer die Geldrechnung, in Cent je kWh ----------------------
# Genutzt von money_update (Kachel TAGESERTRAG und die Sensoren "Ertrag
# heute" usw., docs/06). Demo-Werte, bewusst rund. Die eigenen Tarife
# gehoeren hierher.
tarif_volleinspeisung_ct: "20.0"  # Volleinspeisung
tarif_ueberschuss_ct: "10.0"      # Ueberschusseinspeisung
tarif_bezug_ct: "30.0"            # Strombezug

# --- Netzanschluss (Seite Netz) ---------------------------------------
# pv_kwp: installierte Modulleistung in kWp, auf die sich die
# Einspeisegrenze bezieht. feed_limit_pct: Grenze in %; 60 fuer eine
# Inbetriebnahme 2026 ohne Smart Meter und Steuerbox (§ 9 Abs. 2 EEG,
# docs/06). Demo-Werte.
pv_kwp: "30.0"
feed_limit_pct: "60"

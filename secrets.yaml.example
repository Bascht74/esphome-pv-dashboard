##############################################################################
# Beispiel fuer die secrets.yaml
#
# Die echte secrets.yaml gehoert NICHT ins Repo (.gitignore schliesst sie aus)
# und wird in aller Regel gar nicht von Hand angelegt: Der ESPHome Device
# Builder erzeugt sie beim ersten Start selbst und traegt WLAN-Zugang
# und API-Schluessel ein. Diese Datei hier dokumentiert nur,
# WELCHE Schluessel die Konfiguration erwartet -- wer ohne Device Builder
# arbeitet, kopiert sie nach secrets.yaml und traegt die eigenen Werte ein.
#
# Verwendet werden die Schluessel ausschliesslich in pv-dashboard.yaml, und
# zwar in den substitutions ganz oben. Die Pakete daneben sehen nur ${...}.
##############################################################################

# Das WLAN, in dem das Panel haengt.
wifi_ssid: "MEIN-WLAN"
wifi_password: "mein-wlan-passwort"

# Schluessel der Home-Assistant-API: 32 zufaellige Bytes als Base64.
# Erzeugen z. B. mit:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Der Platzhalter unten ist absichtlich kein Base64 -- er muss ersetzt werden.
encryption_key: "HIER-DEN-ERZEUGTEN-SCHLUESSEL-EINTRAGEN"
# Er verschluesselt auch die Updates ueber das Netz (ota: encryption: {}).
# Ein eigenes OTA-Passwort und ein Fallback-Hotspot gibt es nicht.
